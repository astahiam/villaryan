# PostgreSQL with PostGIS
DATABASE_URL="postgresql://villaryan:villaryan@localhost:5432/villaryan?schema=public"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin session (min 32 characters)
SESSION_SECRET="replace-with-a-long-random-secret-value"
ADMIN_EMAIL="admin@villaryan.id"
ADMIN_PASSWORD="change-me-now"

# StayAPI (leave empty to use the labeled mock adapter)
STAYAPI_API_KEY=
STAYAPI_BASE_URL="https://api.stayapi.com"
STAYAPI_TIMEOUT_MS="8000"

# Maps: server-side geocoding only. Browser maps use OSM/Carto tiles.
# If set, Mapbox Geocoding API is used instead of Nominatim.
MAP_PROVIDER="maplibre"
MAP_PROVIDER_API_KEY=

# Object storage. If empty, photos are stored locally under public/uploads (development).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Nominatim requires a valid identifying user agent
NOMINATIM_USER_AGENT="VillaryanMVP/0.1 (contact@villaryan.id)"
